# Provider credentials are server-only and should be stored as deployment secrets.
IPTV_HOST=http://stream.playbeat.live:80
IPTV_USERNAME=
IPTV_PASSWORD=
# Enable only when public redistribution is explicitly authorized by the provider.
IPTV_PUBLIC_REDISTRIBUTION=false

# Sports data provider (none connected yet — demo data is used until these are set)
SPORTS_DATA_PROVIDER=
SPORTS_DATA_API_KEY=
SPORTS_DATA_BASE_URL=

# Database (Phase 2)
DATABASE_URL=

# Auth (Phase 2)
AUTH_SECRET=
